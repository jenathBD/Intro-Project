// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  // Vores relationer (ikke fra Better Auth). Bevar dem, hvis `npx auth generate` køres igen.
  employee         Employee?
  remainingUpdates RemainingUpdate[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Dashboard-domænet (#10)
// Timer: Decimal(7,2). Kroner: Decimal(10,2). Datoer uden klokkeslæt: @db.Date.
//
// Estimat, resterende og prognose er kun i timer. Kroner bruges kun til omkostningen
// af brugt tid: TimeEntry.hours × TimeEntry.hourlyRate.
//
// Prisen fastlåses, når registreringen oprettes, ud fra projektets prismodel:
//   fixed   → Project.hourlyRate
//   byTitle → ProjectTitleRate for medarbejderens titel, ellers Title.standardRate
// Senere ændringer i priser eller titler påvirker kun nye registreringer.
// ---------------------------------------------------------------------------

enum TimeEntrySource {
  mock
  clockify
  /// Registreret i dashboardet
  manual
}

enum PricingModel {
  /// Samme timepris for alle på projektet
  fixed
  /// Prisen afhænger af medarbejderens titel
  byTitle
}

/// Projektets type (#44). Bestemmer, om det har prismodel, periode og vises i projektoversigten.
enum ProjectKind {
  /// Kundeprojekt: prismodel, kan allokeres i projektets periode
  client
  /// Intern tid, fx kompetenceudvikling eller lavperioder: ingen pris, kan altid allokeres
  internal
  /// Fravær, fx ferie og helligdage: ingen pris og ingen arbejdspakker, kan altid allokeres
  absence
}

/// Stilling, fx "Seniorudvikler". Bestemmer timeprisen på projekter med titelpriser.
model Title {
  id           String             @id @default(cuid())
  name         String             @unique
  /// BD's listepris i kr pr. time. Bruges, når projektet ikke har aftalt en anden pris for titlen.
  standardRate Decimal            @db.Decimal(10, 2)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  employees    Employee[]
  projectRates ProjectTitleRate[]
  timeEntries  TimeEntry[]

  @@map("title")
}

model Project {
  id             String             @id @default(cuid())
  name           String
  customer       String
  kind           ProjectKind        @default(client)
  /// Bruges kun på kundeprojekter. Interne og fraværsprojekter koster 0 kr.
  pricingModel   PricingModel       @default(fixed)
  /// Timepris i kr ved fast pris. Bruges ikke ved titelpriser.
  hourlyRate     Decimal?           @db.Decimal(10, 2)
  /// Sat, når projektet er arkiveret (#14). null = aktivt.
  archivedAt     DateTime?
  /// GitHub-repo som "owner/name" (#50). Arbejdspakkernes issues og epics ligger her.
  githubRepo     String?
  /// Seneste hentning fra GitHub (#24). null = aldrig hentet.
  githubSyncedAt DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  workPackages   WorkPackage[]
  epics          Epic[]
  titleRates     ProjectTitleRate[]
  allocations    Allocation[]

  @@map("project")
}

/// Aftalt pris for en titel på et projekt med titelpriser. Overskriver titlens standardpris.
model ProjectTitleRate {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  titleId    String
  title      Title    @relation(fields: [titleId], references: [id], onDelete: Restrict)
  hourlyRate Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([projectId, titleId])
  @@map("project_title_rate")
}

enum WorkPackageStatus {
  /// Ikke startet
  notStarted
  /// I gang
  inProgress
  /// Afventer (blokeret af noget uden for teamet)
  onHold
  /// Afsluttet
  done
}

/// Kategori for arbejdspakker, fx Analyse eller Design. Standardkategorierne oprettes af migrationen; nye kan tilføjes (#14).
model WorkPackageCategory {
  id           String        @id @default(cuid())
  name         String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  workPackages WorkPackage[]

  @@map("work_package_category")
}

/// Grupperer arbejdspakker som et epic i GitHub (#50). Har intet estimat eller tid selv:
/// tallene er summen af pakkerne, så de ikke kan komme ud af takt.
model Epic {
  id           String        @id @default(cuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  name         String
  /// Epic-issuets nummer i projektets repo. null = findes kun i dashboardet.
  githubNumber Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  workPackages WorkPackage[]

  @@unique([projectId, githubNumber])
  @@map("epic")
}

/// En arbejdspakke svarer til ét GitHub-issue, når projektet har et repo (#50).
/// Estimat, ansvarlig og datoer er valgfrie, fordi alle issues hentes ind, så der kan registreres tid på dem.
model WorkPackage {
  id                 String              @id @default(cuid())
  projectId          String
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  name               String
  description        String?
  /// Én kategori pr. pakke, så opgørelser pr. kategori summerer til projektets total
  categoryId         String
  category           WorkPackageCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Valgfri. Pakker som fx management hører ikke til et epic.
  epicId             String?
  epic               Epic?               @relation(fields: [epicId], references: [id], onDelete: SetNull)
  /// Den ene medarbejder, der er ansvarlig for arbejdspakken
  responsibleId      String?
  responsible        Employee?           @relation("WorkPackageResponsible", fields: [responsibleId], references: [id], onDelete: Restrict)
  status             WorkPackageStatus   @default(notStarted)
  /// null = ikke estimeret. Tæller ikke med i estimatet, men tid på pakken tæller med i brugt og prognose.
  estimateHours      Decimal?            @db.Decimal(7, 2)
  startDate          DateTime?           @db.Date
  /// Deadline i bemandingstjekket (#45). Pakker uden slutdato indgår ikke.
  endDate            DateTime?           @db.Date
  /// Issuets nummer i projektets repo. null = pakken har intet issue.
  githubNumber       Int?
  /// Fra seneste sync (#24): "open" eller "closed"
  githubState        String?
  /// Fra seneste sync (#24): PR'er, der lukker issuet, som [{ number, title, state, url }]. state: open | closed | merged.
  githubPullRequests Json?
  githubSyncedAt     DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  timeEntries        TimeEntry[]
  /// Resterende er altid den seneste opdatering (#13). Gemmes ikke på arbejdspakken.
  remainingUpdates   RemainingUpdate[]

  @@unique([projectId, githubNumber])
  @@index([projectId])
  @@index([responsibleId])
  @@index([epicId])
  @@map("work_package")
}

model Employee {
  id             String        @id @default(cuid())
  name           String
  /// Titlen bestemmer timeprisen på projekter med titelpriser (#18).
  titleId        String
  title          Title         @relation(fields: [titleId], references: [id], onDelete: Restrict)
  /// Timer pr. uge, der kan allokeres (#16).
  weeklyCapacity Decimal       @db.Decimal(5, 2)
  /// Kobling til Clockify (#22).
  clockifyUserId String?       @unique
  /// GitHub-brugernavn (#50). Issuets assignee foreslås som ansvarlig (#24).
  githubLogin    String?       @unique
  /// Kobling til et login (#26, #27). Ikke alle medarbejdere har nødvendigvis en bruger.
  userId         String?       @unique
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  timeEntries    TimeEntry[]
  allocations    Allocation[]
  responsibleFor WorkPackage[] @relation("WorkPackageResponsible")

  @@map("employee")
}

/// Registreret (brugt) tid. Kommer fra mock-data nu og fra Clockify senere (#23).
model TimeEntry {
  id            String          @id @default(cuid())
  employeeId    String
  employee      Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  workPackageId String
  workPackage   WorkPackage     @relation(fields: [workPackageId], references: [id], onDelete: Restrict)
  date          DateTime        @db.Date
  hours         Decimal         @db.Decimal(7, 2)
  /// Medarbejderens titel, da registreringen blev oprettet. Ændres ikke bagudrettet.
  titleId       String
  title         Title           @relation(fields: [titleId], references: [id], onDelete: Restrict)
  /// Timepris i kr, da registreringen blev oprettet. Ændres ikke bagudrettet.
  hourlyRate    Decimal         @db.Decimal(10, 2)
  description   String?
  source        TimeEntrySource @default(mock)
  /// Id i kildesystemet. Gør Clockify-importen idempotent: samme registrering importeres kun én gang.
  externalId    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([source, externalId])
  @@index([workPackageId])
  @@index([employeeId, date])
  @@map("time_entry")
}

/// Andel af en medarbejders tid på et projekt i en given uge (#16, #17).
/// Måles i FTE: hver medarbejder har 1,0 pr. uge at fordele på tværs af projekterne. Over 1,0 = overbooket.
model Allocation {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Mandag i den uge, allokeringen gælder.
  weekStart  DateTime @db.Date
  /// Andel af ugen, i trin af 0,1. 1,0 = hele medarbejderens arbejdstid (weeklyCapacity).
  fte        Decimal  @db.Decimal(3, 1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, projectId, weekStart])
  @@index([weekStart])
  @@map("allocation")
}

/// Udviklerens vurdering af resterende timer på en arbejdspakke. Hver opdatering gemmes som historik (#13, #15).
model RemainingUpdate {
  id             String      @id @default(cuid())
  workPackageId  String
  workPackage    WorkPackage @relation(fields: [workPackageId], references: [id], onDelete: Cascade)
  remainingHours Decimal     @db.Decimal(7, 2)
  comment        String?
  /// Hvem der opdaterede. null for seed-data, eller hvis brugeren er slettet.
  userId         String?
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())

  @@index([workPackageId, createdAt])
  @@map("remaining_update")
}
