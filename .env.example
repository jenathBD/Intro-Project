# Kopiér til .env og udfyld: cp .env.example .env
# .env må aldrig committes.

# Postgres-forbindelse. Værdierne matcher docker-compose.yml.
# Format: postgresql://BRUGER:KODEORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/intro_project"

# Hemmelig nøgle til at signere sessioner. Generér en med: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Appens egen adresse.
BETTER_AUTH_URL="http://localhost:3000"

# GitHub-token til at hente issues og PR'er (#24) og skrive estimat, datoer, kategori og epic (#51). Valgfri.
# Kræver skriveadgang til Issues og læseadgang til Pull requests på de relevante repos og skriveadgang til Projects,
# fx et klassisk token med scopes "repo" og "project". Lokalt kan du bruge: gh auth token
GITHUB_TOKEN=""
