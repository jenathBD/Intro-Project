# Kopiér til .env og udfyld: cp .env.example .env
# .env må aldrig committes.

# Postgres-forbindelse. Værdierne matcher docker-compose.yml.
# Format: postgresql://BRUGER:KODEORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/intro_project"

# Hemmelig nøgle til at signere sessioner. Generér en med: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Appens egen adresse.
BETTER_AUTH_URL="http://localhost:3000"

# GitHub-token til at hente issues og PR'er (#24). Valgfri: uden token virker alt andet.
# Fine-grained token med læseadgang til Issues og Pull requests på de relevante repos,
# eller et klassisk token med scope "repo". Lokalt kan du bruge: gh auth token
GITHUB_TOKEN=""
